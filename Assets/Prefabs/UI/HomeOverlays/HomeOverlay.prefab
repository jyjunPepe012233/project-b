  m_Script: {fileID: 11500000, guid: c1649fca26374089af92ce85c0e6b3bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  note: "HomeOverlay \uD558\uC704\uC758 Canvas\uC5D0 UIGroup\uC774 \uB610 \uC788\uB354\uB77C\uB3C4,
    Homeoverlay \uB2E8\uACC4\uC758 UIGroup\uC740 \uBC18\uB4DC\uC2DC \uD544\uC694\uD568.\n\n\uC608\uB97C
    \uB4E4\uC5B4 Canvas_Lobby\uC5D0\uB9CC UIGroup\uC774 \uC788\uC73C\uBA74, Homeoverlay\uAC00
    \uCF1C\uC9C8 \uB54C Canvas_Lobby\uC5D0 \uC788\uB294 UIGroup\uC774 Show\uB418\uB294\uB370,
    \uC774 \uB54C Canvas_Lobby\uC5D0 \uBD99\uC5B4\uC788\uB294 UIGroup\uC740 \uADF8
    \uC624\uBE0C\uC81D\uD2B8\uC5D0 \uBD99\uC5B4\uC788\uB294 Presenter\uB4E4\uC740
    \uD65C\uC131\uD654\uC2DC\uD0A4\uC9C0 \uC54A\uC74C.\n\uC989, Homeoverlay\uB97C
    \uD65C\uC131\uD654\uD558\uB354\uB77C\uB3C4 Canvas\uC758 \uB8E8\uD2B8\uC5D0 \uBD99\uC5B4\uC788\uB294
    \uCEF4\uD3EC\uB10C\uD2B8\uB294 \uC81C\uC5B4\uBC1B\uC9C0 \uBABB\uD558\uB294 \uC0C1\uD669\uC774
    \uBC1C\uC0DD\uD568\n\n\uADF8\uB798\uC11C \uBD88\uD544\uC694\uD574\uBCF4\uC774\uB354\uB77C\uB3C4
    HomeOverlay\uC640 Canvas\uC5D0\uB294 \uAC01\uAC01\uC758 UIGroup\uACFC CanvasGroup\uC744
    \uBC30\uCE58\uD558\uB294 \uAC83\uC784\n\n\uBB3C\uB860 HomeOverlay\uC5D0 \uC788\uB294
    UIGroup \uD558\uB098\uB9CC\uC73C\uB85C \uD558\uC704\uC758 \uBAA8\uB4E0 Presenter\uB4E4\uC744
    \uC81C\uC5B4\uD560 \uC218 \uC788\uAE34 \uD558\uC9C0\uB9CC, Canvas_Lobby\uC640
    \uAC19\uC740 UI \uBAA8\uB4C8\uB4E4\uC740 UIGroup\uC744 \uAC00\uC9C0\uB294 \uAC83\uC774
    \uC758\uBBF8 \uC0C1\uC73C\uB85C \uAC00\uC7A5 \uC790\uC5F0\uC2A4\uB7EC\uC6C0"
